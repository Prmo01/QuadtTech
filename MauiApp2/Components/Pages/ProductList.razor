@page "/products"
@layout MainLayout
@using MauiApp2.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="dashboard-wrapper">
    <Sidebar />

    <div class="main-content">
        <div class="content-header">
            <h1>Inventory Management</h1>
        </div>

        <div class="inventory-section">
            <div class="tab-section">
                <div class="tabs">
                    <button class="tab active">Product List</button>
                </div>
            </div>

            <div class="product-table-container">
                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-error">
                        <span class="alert-icon">⚠️</span>
                        <span>@errorMessage</span>
                        <button class="alert-close" @onclick="ClearErrorMessage">×</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">
                        <span class="alert-icon">✅</span>
                        <span>@successMessage</span>
                        <button class="alert-close" @onclick="ClearSuccessMessage">×</button>
                    </div>
                }

                <div class="toolbar">
                    <button class="add-item-btn" @onclick="ShowAddModal">
                        Add Item
                    </button>

                    <div class="search-container">
                        <input type="text"
                               class="search-input"
                               placeholder="Enter product name, SKU, or Model Number"
                               @bind="searchQuery"
                               @bind:event="oninput" />
                        <span class="search-icon">🔎︎</span>
                    </div>
                </div>

                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Brand</th>
                            <th>SKU</th>
                            <th>Model Number</th>
                            <th>Cost Price</th>
                            <th>Sell Price</th>
                            <th>Status</th>
                            <th>Quantity</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredProducts.Any())
                        {
                            @foreach (var product in FilteredProducts)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.Category</td>
                                    <td>@product.Brand</td>
                                    <td>@product.SKU</td>
                                    <td>@product.ModelNumber</td>
                                    <td>₱@product.CostPrice.ToString("N2")</td>
                                    <td>₱@product.SellPrice.ToString("N2")</td>
                                    <td>
                                        <span class="status-badge @product.Status.ToLower()">@product.Status</span>
                                    </td>
                                    <td>@product.Quantity</td>
                                    <td>
                                        <button class="edit-btn" @onclick="() => ShowEditModal(product)">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" style="text-align: center; padding: 40px; color: #6b7280;">
                                    @if (string.IsNullOrWhiteSpace(searchQuery))
                                    {
                                        <span>No products found. Click "Add Item" to add your first product.</span>
                                    }
                                    else
                                    {
                                        <span>No products match your search criteria.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Item Modal -->
@if (showAddModal)
{
    <div class="modal-overlay" @onclick="CloseAddModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Add New Product</h3>
                <button class="modal-close" @onclick="CloseAddModal">×</button>
            </div>
            <div class="modal-body">
                <!-- Validation Summary -->
                @if (validationErrors?.Any() == true)
                {
                    <div class="validation-summary">
                        <h4>Please fix the following errors:</h4>
                        <ul>
                            @foreach (var error in validationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-container">
                    <div class="form-group">
                        <label>Product Name *</label>
                        <input type="text"
                               class="form-control @(HasError("ProductName") ? "input-error" : "")"
                               @bind="newProductName"
                               placeholder="Enter product name"
                               maxlength="100" />
                        @if (HasError("ProductName"))
                        {
                            <span class="field-error">@GetError("ProductName")</span>
                        }
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Category *</label>
                            <select class="form-control @(HasError("Category") ? "input-error" : "")"
                                    @bind="newCategory">
                                <option value="">Select Category</option>
                                @foreach (var category in availableCategories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            @if (HasError("Category"))
                            {
                                <span class="field-error">@GetError("Category")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Brand *</label>
                            <select class="form-control @(HasError("Brand") ? "input-error" : "")"
                                    @bind="newBrand">
                                <option value="">Select Brand</option>
                                @foreach (var brand in availableBrands)
                                {
                                    <option value="@brand">@brand</option>
                                }
                            </select>
                            @if (HasError("Brand"))
                            {
                                <span class="field-error">@GetError("Brand")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>SKU *</label>
                            <input type="text"
                                   class="form-control @(HasError("SKU") ? "input-error" : "")"
                                   @bind="newSKU"
                                   placeholder="Enter SKU"
                                   maxlength="50" />
                            @if (HasError("SKU"))
                            {
                                <span class="field-error">@GetError("SKU")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Model Number *</label>
                            <input type="text"
                                   class="form-control @(HasError("ModelNumber") ? "input-error" : "")"
                                   @bind="newModelNumber"
                                   placeholder="Enter model number"
                                   maxlength="50" />
                            @if (HasError("ModelNumber"))
                            {
                                <span class="field-error">@GetError("ModelNumber")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Cost Price (₱) *</label>
                            <input type="number"
                                   class="form-control @(HasError("CostPrice") ? "input-error" : "")"
                                   @bind="newCostPrice"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />
                            @if (HasError("CostPrice"))
                            {
                                <span class="field-error">@GetError("CostPrice")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Sell Price (₱) *</label>
                            <input type="number"
                                   class="form-control @(HasError("SellPrice") ? "input-error" : "")"
                                   @bind="newSellPrice"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />
                            @if (HasError("SellPrice"))
                            {
                                <span class="field-error">@GetError("SellPrice")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Status *</label>
                            <select class="form-control @(HasError("Status") ? "input-error" : "")"
                                    @bind="newStatus">
                                <option value="">Select Status</option>
                                @foreach (var status in availableStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            @if (HasError("Status"))
                            {
                                <span class="field-error">@GetError("Status")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Quantity</label>
                            <input type="text"
                                   class="form-control"
                                   value="0"
                                   disabled
                                   placeholder="Set via Stock In module" />
                            <small class="form-help">Quantity is managed through the Stock In module</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseAddModal">Cancel</button>
                <button class="btn-submit" @onclick="AddProduct" disabled="@(!IsFormValid)">Add Product</button>
            </div>
        </div>
    </div>
}

<!-- Edit Item Modal -->
@if (showEditModal && editingProduct != null)
{
    <div class="modal-overlay" @onclick="CloseEditModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Edit Product</h3>
                <button class="modal-close" @onclick="CloseEditModal">×</button>
            </div>
            <div class="modal-body">
                <!-- Validation Summary -->
                @if (editValidationErrors?.Any() == true)
                {
                    <div class="validation-summary">
                        <h4>Please fix the following errors:</h4>
                        <ul>
                            @foreach (var error in editValidationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-container">
                    <div class="form-group">
                        <label>Product Name *</label>
                        <input type="text"
                               class="form-control @(HasEditError("ProductName") ? "input-error" : "")"
                               @bind="editProductName"
                               placeholder="Enter product name"
                               maxlength="100" />
                        @if (HasEditError("ProductName"))
                        {
                            <span class="field-error">@GetEditError("ProductName")</span>
                        }
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Category *</label>
                            <select class="form-control @(HasEditError("Category") ? "input-error" : "")"
                                    @bind="editCategory">
                                <option value="">Select Category</option>
                                @foreach (var category in availableCategories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            @if (HasEditError("Category"))
                            {
                                <span class="field-error">@GetEditError("Category")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Brand *</label>
                            <select class="form-control @(HasEditError("Brand") ? "input-error" : "")"
                                    @bind="editBrand">
                                <option value="">Select Brand</option>
                                @foreach (var brand in availableBrands)
                                {
                                    <option value="@brand">@brand</option>
                                }
                            </select>
                            @if (HasEditError("Brand"))
                            {
                                <span class="field-error">@GetEditError("Brand")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>SKU *</label>
                            <input type="text"
                                   class="form-control @(HasEditError("SKU") ? "input-error" : "")"
                                   @bind="editSKU"
                                   placeholder="Enter SKU"
                                   maxlength="50" />
                            @if (HasEditError("SKU"))
                            {
                                <span class="field-error">@GetEditError("SKU")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Model Number *</label>
                            <input type="text"
                                   class="form-control @(HasEditError("ModelNumber") ? "input-error" : "")"
                                   @bind="editModelNumber"
                                   placeholder="Enter model number"
                                   maxlength="50" />
                            @if (HasEditError("ModelNumber"))
                            {
                                <span class="field-error">@GetEditError("ModelNumber")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Cost Price (₱) *</label>
                            <input type="number"
                                   class="form-control @(HasEditError("CostPrice") ? "input-error" : "")"
                                   @bind="editCostPrice"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />
                            @if (HasEditError("CostPrice"))
                            {
                                <span class="field-error">@GetEditError("CostPrice")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Sell Price (₱) *</label>
                            <input type="number"
                                   class="form-control @(HasEditError("SellPrice") ? "input-error" : "")"
                                   @bind="editSellPrice"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />
                            @if (HasEditError("SellPrice"))
                            {
                                <span class="field-error">@GetEditError("SellPrice")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Status *</label>
                            <select class="form-control @(HasEditError("Status") ? "input-error" : "")"
                                    @bind="editStatus">
                                <option value="">Select Status</option>
                                @foreach (var status in availableStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            @if (HasEditError("Status"))
                            {
                                <span class="field-error">@GetEditError("Status")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Current Quantity</label>
                            <input type="text"
                                   class="form-control"
                                   value="@editingProduct.Quantity"
                                   disabled />
                            <small class="form-help">Quantity is managed through the Stock In module</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseEditModal">Cancel</button>
                <button class="btn-submit" @onclick="UpdateProduct" disabled="@(!IsEditFormValid)">Update Product</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isInventoryMenuOpen = true;
    private string searchQuery = "";
    private List<Product> products = new();
    private bool showAddModal = false;
    private bool showEditModal = false;
    private Product? editingProduct = null;

    // Available options for dropdowns
    private List<string> availableCategories = new List<string>
    {
        "Refrigerator",
        "Television", 
        "Air Conditioner",
        "Washing Machine",
        "Kitchen Appliance",
        "Small Appliance",
        "Audio Equipment",
        "Other"
    };

    private List<string> availableBrands = new List<string>
    {
        "LG",
        "Samsung",
        "Panasonic",
        "Sharp",
        "Toshiba",
        "Sony",
        "Whirlpool",
        "Other"
    };

    private List<string> availableStatuses = new List<string>
    {
        "Active",
        "Inactive", 
        "Discontinued"
    };

    // Add form fields
    private string newProductName = "";
    private string newCategory = "";
    private string newBrand = "";
    private string newSKU = "";
    private string newModelNumber = "";
    private decimal newCostPrice = 0;
    private decimal newSellPrice = 0;
    private string newStatus = "";
    private int newQuantity = 0;

    // Edit form fields
    private string editProductName = "";
    private string editCategory = "";
    private string editBrand = "";
    private string editSKU = "";
    private string editModelNumber = "";
    private decimal editCostPrice = 0;
    private decimal editSellPrice = 0;
    private string editStatus = "";

    // Messages and validation
    private string errorMessage = "";
    private string successMessage = "";
    private List<string> validationErrors = new List<string>();
    private List<string> editValidationErrors = new List<string>();

    public class Product
    {
        public string ProductId { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string Category { get; set; } = "";
        public string Brand { get; set; } = "";
        public string SKU { get; set; } = "";
        public string ModelNumber { get; set; } = "";
        public decimal CostPrice { get; set; }
        public decimal SellPrice { get; set; }
        public string Status { get; set; } = "Active";
        public int Quantity { get; set; }
    }

    protected override void OnInitialized()
    {
        LoadProducts();
    }

    private void ToggleInventoryMenu()
    {
        isInventoryMenuOpen = !isInventoryMenuOpen;
    }

    private void LoadProducts()
    {
        // Start with empty list - no hardcoded data
        products = new List<Product>();
    }

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
                return products;

            return products.Where(p =>
                p.ProductName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.SKU.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.ModelNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.Brand.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    // Modal Methods
    private void ShowAddModal()
    {
        showAddModal = true;
        ClearMessages();
        ResetAddForm();
        StateHasChanged();
    }

    private void CloseAddModal()
    {
        showAddModal = false;
        ResetAddForm();
        StateHasChanged();
    }

    private void ShowEditModal(Product product)
    {
        editingProduct = product;
        showEditModal = true;
        ClearMessages();

        // Populate edit form
        editProductName = product.ProductName;
        editCategory = product.Category;
        editBrand = product.Brand;
        editSKU = product.SKU;
        editModelNumber = product.ModelNumber;
        editCostPrice = product.CostPrice;
        editSellPrice = product.SellPrice;
        editStatus = product.Status;

        StateHasChanged();
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingProduct = null;
        ResetEditForm();
        StateHasChanged();
    }

    // Form Methods
    private void ResetAddForm()
    {
        newProductName = "";
        newCategory = "";
        newBrand = "";
        newSKU = "";
        newModelNumber = "";
        newCostPrice = 0;
        newSellPrice = 0;
        newStatus = "";
        newQuantity = 0;
        validationErrors.Clear();
    }

    private void ResetEditForm()
    {
        editProductName = "";
        editCategory = "";
        editBrand = "";
        editSKU = "";
        editModelNumber = "";
        editCostPrice = 0;
        editSellPrice = 0;
        editStatus = "";
        editValidationErrors.Clear();
    }

    private void ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
        validationErrors.Clear();
        editValidationErrors.Clear();
    }

    private void ClearErrorMessage() => errorMessage = "";
    private void ClearSuccessMessage() => successMessage = "";

    // Validation Methods
    private void ValidateAddForm()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(newProductName))
            AddValidationError("ProductName", "Product name is required");
        else if (newProductName.Length < 2)
            AddValidationError("ProductName", "Product name must be at least 2 characters long");

        if (string.IsNullOrWhiteSpace(newCategory))
            AddValidationError("Category", "Category is required");

        if (string.IsNullOrWhiteSpace(newBrand))
            AddValidationError("Brand", "Brand is required");

        if (string.IsNullOrWhiteSpace(newSKU))
            AddValidationError("SKU", "SKU is required");
        else if (products.Any(p => p.SKU.Equals(newSKU, StringComparison.OrdinalIgnoreCase)))
            AddValidationError("SKU", "SKU already exists");

        if (string.IsNullOrWhiteSpace(newModelNumber))
            AddValidationError("ModelNumber", "Model number is required");

        if (newCostPrice <= 0)
            AddValidationError("CostPrice", "Cost price must be greater than 0");
        else if (newCostPrice > 1000000)
            AddValidationError("CostPrice", "Cost price cannot exceed ₱1,000,000");

        if (newSellPrice <= 0)
            AddValidationError("SellPrice", "Sell price must be greater than 0");
        else if (newSellPrice > 1000000)
            AddValidationError("SellPrice", "Sell price cannot exceed ₱1,000,000");

        if (newSellPrice < newCostPrice)
            AddValidationError("SellPrice", "Sell price cannot be less than cost price");

        if (string.IsNullOrWhiteSpace(newStatus))
            AddValidationError("Status", "Status is required");
    }

    private void ValidateEditForm()
    {
        editValidationErrors.Clear();

        if (string.IsNullOrWhiteSpace(editProductName))
            AddEditValidationError("ProductName", "Product name is required");
        else if (editProductName.Length < 2)
            AddEditValidationError("ProductName", "Product name must be at least 2 characters long");

        if (string.IsNullOrWhiteSpace(editCategory))
            AddEditValidationError("Category", "Category is required");

        if (string.IsNullOrWhiteSpace(editBrand))
            AddEditValidationError("Brand", "Brand is required");

        if (string.IsNullOrWhiteSpace(editSKU))
            AddEditValidationError("SKU", "SKU is required");
        else if (products.Any(p => p.SKU.Equals(editSKU, StringComparison.OrdinalIgnoreCase) && p.ProductId != editingProduct?.ProductId))
            AddEditValidationError("SKU", "SKU already exists");

        if (string.IsNullOrWhiteSpace(editModelNumber))
            AddEditValidationError("ModelNumber", "Model number is required");

        if (editCostPrice <= 0)
            AddEditValidationError("CostPrice", "Cost price must be greater than 0");
        else if (editCostPrice > 1000000)
            AddEditValidationError("CostPrice", "Cost price cannot exceed ₱1,000,000");

        if (editSellPrice <= 0)
            AddEditValidationError("SellPrice", "Sell price must be greater than 0");
        else if (editSellPrice > 1000000)
            AddEditValidationError("SellPrice", "Sell price cannot exceed ₱1,000,000");

        if (editSellPrice < editCostPrice)
            AddEditValidationError("SellPrice", "Sell price cannot be less than cost price");

        if (string.IsNullOrWhiteSpace(editStatus))
            AddEditValidationError("Status", "Status is required");
    }

    private void AddValidationError(string field, string message)
    {
        validationErrors.Add($"{field}: {message}");
    }

    private void AddEditValidationError(string field, string message)
    {
        editValidationErrors.Add($"{field}: {message}");
    }

    private bool HasError(string field)
    {
        return validationErrors.Any(error => error.StartsWith($"{field}:"));
    }

    private bool HasEditError(string field)
    {
        return editValidationErrors.Any(error => error.StartsWith($"{field}:"));
    }

    private string GetError(string field)
    {
        return validationErrors.FirstOrDefault(error => error.StartsWith($"{field}:"))?.Split(':')[1]?.Trim() ?? "";
    }

    private string GetEditError(string field)
    {
        return editValidationErrors.FirstOrDefault(error => error.StartsWith($"{field}:"))?.Split(':')[1]?.Trim() ?? "";
    }

    private bool IsFormValid
    {
        get
        {
            ValidateAddForm();
            return validationErrors.Count == 0 &&
                   !string.IsNullOrWhiteSpace(newProductName) &&
                   !string.IsNullOrWhiteSpace(newCategory) &&
                   !string.IsNullOrWhiteSpace(newBrand) &&
                   !string.IsNullOrWhiteSpace(newSKU) &&
                   !string.IsNullOrWhiteSpace(newModelNumber) &&
                   !string.IsNullOrWhiteSpace(newStatus) &&
                   newCostPrice > 0 &&
                   newSellPrice > 0 &&
                   newSellPrice >= newCostPrice;
        }
    }

    private bool IsEditFormValid
    {
        get
        {
            ValidateEditForm();
            return editValidationErrors.Count == 0 &&
                   !string.IsNullOrWhiteSpace(editProductName) &&
                   !string.IsNullOrWhiteSpace(editCategory) &&
                   !string.IsNullOrWhiteSpace(editBrand) &&
                   !string.IsNullOrWhiteSpace(editSKU) &&
                   !string.IsNullOrWhiteSpace(editModelNumber) &&
                   !string.IsNullOrWhiteSpace(editStatus) &&
                   editCostPrice > 0 &&
                   editSellPrice > 0 &&
                   editSellPrice >= editCostPrice;
        }
    }

    // CRUD Operations
    private void AddProduct()
    {
        ValidateAddForm();

        if (!IsFormValid)
        {
            errorMessage = "Please fix the validation errors before submitting.";
            return;
        }

        try
        {
            var newProductId = products.Any() ? (products.Max(p => int.Parse(p.ProductId)) + 1).ToString() : "1";

            var newProduct = new Product
            {
                ProductId = newProductId,
                ProductName = newProductName.Trim(),
                Category = newCategory,
                Brand = newBrand,
                SKU = newSKU.Trim(),
                ModelNumber = newModelNumber.Trim(),
                CostPrice = newCostPrice,
                SellPrice = newSellPrice,
                Status = newStatus,
                Quantity = 0 // Initial quantity is always 0
            };

            products.Add(newProduct);
            successMessage = $"Product '{newProductName}' added successfully!";

            CloseAddModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding product: {ex.Message}";
        }
    }

    private void UpdateProduct()
    {
        ValidateEditForm();

        if (!IsEditFormValid || editingProduct == null)
        {
            errorMessage = "Please fix the validation errors before submitting.";
            return;
        }

        try
        {
            var productToUpdate = products.FirstOrDefault(p => p.ProductId == editingProduct.ProductId);
            if (productToUpdate != null)
            {
                productToUpdate.ProductName = editProductName.Trim();
                productToUpdate.Category = editCategory;
                productToUpdate.Brand = editBrand;
                productToUpdate.SKU = editSKU.Trim();
                productToUpdate.ModelNumber = editModelNumber.Trim();
                productToUpdate.CostPrice = editCostPrice;
                productToUpdate.SellPrice = editSellPrice;
                productToUpdate.Status = editStatus;

                successMessage = $"Product '{editProductName}' updated successfully!";
            }

            CloseEditModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating product: {ex.Message}";
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}