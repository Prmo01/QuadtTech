@page "/users"
@layout MainLayout
@using MauiApp2.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<link href="css/userlist.css" rel="stylesheet" />


<div class="dashboard-wrapper">
    <Sidebar />

    <div class="main-content">
        <div class="content-header">
            <h1>User Management</h1>
            <p>Manage system users and their permissions</p>
        </div>

        <div class="inventory-section">
            <div class="tab-section">
                <div class="tabs">
                    <button class="tab active">User List</button>
                </div>
            </div>

            <div class="product-table-container">
                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-triangle alert-icon"></i>
                        <span>@errorMessage</span>
                        <button class="alert-close" @onclick="ClearErrorMessage">×</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle alert-icon"></i>
                        <span>@successMessage</span>
                        <button class="alert-close" @onclick="ClearSuccessMessage">×</button>
                    </div>
                }

                <div class="toolbar">
                    <button class="add-item-btn" @onclick="ShowAddModal">
                        <i class="fas fa-user-plus"></i>
                        Add User
                    </button>

                    <div class="search-container">
                        <input type="text"
                               class="search-input"
                               placeholder="Search users by name, email, or role..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                        <i class="fas fa-search search-icon"></i>
                    </div>
                </div>

                <table class="product-table">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredUsers.Any())
                        {
                            @foreach (var user in FilteredUsers)
                            {
                                <tr>
                                    <td>@user.UserId</td>
                                    <td>
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div class="user-details">
                                                <div class="user-name">@user.FullName</div>
                                                <div class="user-position">@user.Position</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="role-badge @user.Role.ToLower()">
                                            <i class="@GetRoleIcon(user.Role)"></i>
                                            @user.Role
                                        </span>
                                    </td>
                                    <td>@user.Department</td>
                                    <td>
                                        <span class="status-badge @user.Status.ToLower()">
                                            <i class="@GetStatusIcon(user.Status)"></i>
                                            @user.Status
                                        </span>
                                    </td>
                                    <td>@user.LastLogin?.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="edit-btn" @onclick="() => ShowEditModal(user)" title="Edit User">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="reset-btn" @onclick="() => ShowResetPasswordModal(user)" title="Reset Password">
                                                <i class="fas fa-key"></i>
                                            </button>
                                            @if (user.Status == "Active")
                                            {
                                                <button class="deactivate-btn" @onclick="() => ToggleUserStatus(user)" title="Deactivate User">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="activate-btn" @onclick="() => ToggleUserStatus(user)" title="Activate User">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="no-data">
                                    <i class="fas fa-users no-data-icon"></i>
                                    <div class="no-data-text">
                                        @if (string.IsNullOrWhiteSpace(searchQuery))
                                        {
                                            <span>No users found. Click "Add User" to create your first user.</span>
                                        }
                                        else
                                        {
                                            <span>No users match your search criteria.</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
@if (showAddModal)
{
    <div class="modal-overlay" @onclick="CloseAddModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-user-plus"></i> Add New User</h3>
                <button class="modal-close" @onclick="CloseAddModal">×</button>
            </div>
            <div class="modal-body">
                <!-- Validation Summary -->
                @if (validationErrors?.Any() == true)
                {
                    <div class="validation-summary">
                        <i class="fas fa-exclamation-circle"></i>
                        <h4>Please fix the following errors:</h4>
                        <ul>
                            @foreach (var error in validationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-container">
                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-id-card"></i> User ID *</label>
                            <input type="text"
                                   class="form-control"
                                   value="@newUserId"
                                   disabled
                                   placeholder="Auto-generated" />
                            <small class="form-help">User ID is automatically generated</small>
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Position</label>
                            <input type="text"
                                   class="form-control"
                                   @bind="newPosition"
                                   placeholder="Enter position title"
                                   maxlength="50" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-signature"></i> First Name *</label>
                            <input type="text"
                                   class="form-control @(HasError("FirstName") ? "input-error" : "")"
                                   @bind="newFirstName"
                                   placeholder="Enter first name"
                                   maxlength="50" />
                            @if (HasError("FirstName"))
                            {
                                <span class="field-error">@GetError("FirstName")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-signature"></i> Last Name *</label>
                            <input type="text"
                                   class="form-control @(HasError("LastName") ? "input-error" : "")"
                                   @bind="newLastName"
                                   placeholder="Enter last name"
                                   maxlength="50" />
                            @if (HasError("LastName"))
                            {
                                <span class="field-error">@GetError("LastName")</span>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email Address *</label>
                        <input type="email"
                               class="form-control @(HasError("Email") ? "input-error" : "")"
                               @bind="newEmail"
                               placeholder="Enter email address"
                               maxlength="100" />
                        @if (HasError("Email"))
                        {
                            <span class="field-error">@GetError("Email")</span>
                        }
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-shield-alt"></i> Role *</label>
                            <select class="form-control @(HasError("Role") ? "input-error" : "")"
                                    @bind="newRole">
                                <option value="">Select Role</option>
                                <option value="Administrator">Administrator</option>
                                <option value="Manager">Manager</option>
                                <option value="Staff">Staff</option>
                                <option value="Viewer">Viewer</option>
                            </select>
                            @if (HasError("Role"))
                            {
                                <span class="field-error">@GetError("Role")</span>
                            }
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-building"></i> Department *</label>
                            <select class="form-control @(HasError("Department") ? "input-error" : "")"
                                    @bind="newDepartment">
                                <option value="">Select Department</option>
                                <option value="Administration">Administration</option>
                                <option value="Sales">Sales</option>
                                <option value="Inventory">Inventory</option>
                                <option value="IT">IT</option>
                                <option value="Finance">Finance</option>
                                <option value="Operations">Operations</option>
                            </select>
                            @if (HasError("Department"))
                            {
                                <span class="field-error">@GetError("Department")</span>
                            }
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-phone"></i> Phone Number</label>
                            <input type="tel"
                                   class="form-control"
                                   @bind="newPhoneNumber"
                                   placeholder="Enter phone number"
                                   maxlength="20" />
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-toggle-on"></i> Status *</label>
                            <select class="form-control @(HasError("Status") ? "input-error" : "")"
                                    @bind="newStatus">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            @if (HasError("Status"))
                            {
                                <span class="field-error">@GetError("Status")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseAddModal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button class="btn-submit" @onclick="AddUser" disabled="@(!IsFormValid)">
                    <i class="fas fa-save"></i> Add User
                </button>
            </div>
        </div>
    </div>
}

