<!-- Reset Password Modal -->
@if (showResetPasswordModal && resettingUser != null)
{
    <div class="modal-overlay" @onclick="CloseResetPasswordModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-key"></i> Reset Password</h3>
                <button class="modal-close" @onclick="CloseResetPasswordModal">×</button>
            </div>
            <div class="modal-body">
                <div class="reset-password-content">
                    <i class="fas fa-key reset-password-icon"></i>
                    <p>Are you sure you want to reset the password for <strong>@resettingUser.FullName</strong>?</p>
                    <p class="reset-warning">A temporary password will be generated and sent to their email address.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseResetPasswordModal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button class="btn-submit" @onclick="ResetPassword">
                    <i class="fas fa-sync-alt"></i> Reset Password
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string searchQuery = "";
    private List<User> users = new();
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showResetPasswordModal = false;
    private User? editingUser = null;
    private User? resettingUser = null;

    // Add form fields
    private string newUserId = "";
    private string newFirstName = "";
    private string newLastName = "";
    private string newEmail = "";
    private string newRole = "";
    private string newDepartment = "";
    private string newPosition = "";
    private string newPhoneNumber = "";
    private string newStatus = "Active";

    // Edit form fields
    private string editFirstName = "";
    private string editLastName = "";
    private string editEmail = "";
    private string editRole = "";
    private string editDepartment = "";
    private string editPosition = "";
    private string editPhoneNumber = "";
    private string editStatus = "Active";

    // Messages and validation
    private string errorMessage = "";
    private string successMessage = "";
    private List<string> validationErrors = new List<string>();
    private List<string> editValidationErrors = new List<string>();

    public class User
    {
        public string UserId { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string FullName => $"{FirstName} {LastName}";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string Department { get; set; } = "";
        public string Position { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Status { get; set; } = "Active";
        public DateTime? LastLogin { get; set; }
        public DateTime CreatedDate { get; set; } = DateTime.Now;
    }

    protected override void OnInitialized()
    {
        LoadUsers();
        GenerateNewUserId();
    }

    private void LoadUsers()
    {
        users = new List<User>
        {
            new User
            {
                UserId = "USR1001",
                FirstName = "John",
                LastName = "Smith",
                Email = "john.smith@company.com",
                Role = "Administrator",
                Department = "Administration",
                Position = "System Administrator",
                PhoneNumber = "+63 912 345 6789",
                Status = "Active",
                LastLogin = DateTime.Now.AddHours(-2)
            },
            new User
            {
                UserId = "USR1002",
                FirstName = "Maria",
                LastName = "Garcia",
                Email = "maria.garcia@company.com",
                Role = "Manager",
                Department = "Sales",
                Position = "Sales Manager",
                PhoneNumber = "+63 917 654 3210",
                Status = "Active",
                LastLogin = DateTime.Now.AddDays(-1)
            },
            new User
            {
                UserId = "USR1003",
                FirstName = "James",
                LastName = "Johnson",
                Email = "james.johnson@company.com",
                Role = "Staff",
                Department = "Inventory",
                Position = "Inventory Specialist",
                PhoneNumber = "+63 918 765 4321",
                Status = "Active",
                LastLogin = DateTime.Now.AddDays(-3)
            },
            new User
            {
                UserId = "USR1004",
                FirstName = "Sarah",
                LastName = "Chen",
                Email = "sarah.chen@company.com",
                Role = "Staff",
                Department = "Finance",
                Position = "Finance Officer",
                PhoneNumber = "+63 919 876 5432",
                Status = "Inactive",
                LastLogin = DateTime.Now.AddMonths(-2)
            },
            new User
            {
                UserId = "USR1005",
                FirstName = "Michael",
                LastName = "Tan",
                Email = "michael.tan@company.com",
                Role = "Viewer",
                Department = "Operations",
                Position = "Operations Analyst",
                PhoneNumber = "+63 920 987 6543",
                Status = "Active",
                LastLogin = DateTime.Now.AddHours(-12)
            }
        };
    }

    private void GenerateNewUserId()
    {
        if (users.Any())
        {
            var lastId = users.Max(u => int.Parse(u.UserId.Replace("USR", "")));
            newUserId = $"USR{lastId + 1}";
        }
        else
        {
            newUserId = "USR1001";
        }
    }

    private IEnumerable<User> FilteredUsers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
                return users;

            return users.Where(u =>
                u.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                u.Role.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                u.Department.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                u.Position.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                u.UserId.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    // Icon helper methods
    private string GetRoleIcon(string role)
    {
        return role switch
        {
            "Administrator" => "fas fa-crown",
            "Manager" => "fas fa-user-tie",
            "Staff" => "fas fa-user",
            "Viewer" => "fas fa-eye",
            _ => "fas fa-user"
        };
    }

    private string GetStatusIcon(string status)
    {
        return status switch
        {
            "Active" => "fas fa-check-circle",
            "Inactive" => "fas fa-times-circle",
            _ => "fas fa-question-circle"
        };
    }

    // Modal Methods
    private void ShowAddModal()
    {
        showAddModal = true;
        ClearMessages();
        ResetAddForm();
        GenerateNewUserId();
        StateHasChanged();
    }

    private void CloseAddModal()
    {
        showAddModal = false;
        ResetAddForm();
        StateHasChanged();
    }

    private void ShowEditModal(User user)
    {
        editingUser = user;
        showEditModal = true;
        ClearMessages();

        // Populate edit form
        editFirstName = user.FirstName;
        editLastName = user.LastName;
        editEmail = user.Email;
        editRole = user.Role;
        editDepartment = user.Department;
        editPosition = user.Position;
        editPhoneNumber = user.PhoneNumber;
        editStatus = user.Status;

        StateHasChanged();
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingUser = null;
        ResetEditForm();
        StateHasChanged();
    }

    private void ShowResetPasswordModal(User user)
    {
        resettingUser = user;
        showResetPasswordModal = true;
        ClearMessages();
        StateHasChanged();
    }

    private void CloseResetPasswordModal()
    {
        showResetPasswordModal = false;
        resettingUser = null;
        StateHasChanged();
    }

    // Form Methods
    private void ResetAddForm()
    {
        newFirstName = "";
        newLastName = "";
        newEmail = "";
        newRole = "";
        newDepartment = "";
        newPosition = "";
        newPhoneNumber = "";
        newStatus = "Active";
        validationErrors.Clear();
    }

    private void ResetEditForm()
    {
        editFirstName = "";
        editLastName = "";
        editEmail = "";
        editRole = "";
        editDepartment = "";
        editPosition = "";
        editPhoneNumber = "";
        editStatus = "Active";
        editValidationErrors.Clear();
    }

    private void ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
        validationErrors.Clear();
        editValidationErrors.Clear();
    }

    private void ClearErrorMessage() => errorMessage = "";
    private void ClearSuccessMessage() => successMessage = "";

    // Validation Methods
    private void ValidateAddForm()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(newFirstName))
            AddValidationError("FirstName", "First name is required");
        else if (newFirstName.Length < 2)
            AddValidationError("FirstName", "First name must be at least 2 characters long");

        if (string.IsNullOrWhiteSpace(newLastName))
            AddValidationError("LastName", "Last name is required");
        else if (newLastName.Length < 2)
            AddValidationError("LastName", "Last name must be at least 2 characters long");

        if (string.IsNullOrWhiteSpace(newEmail))
            AddValidationError("Email", "Email is required");
        else if (!IsValidEmail(newEmail))
            AddValidationError("Email", "Please enter a valid email address");

        if (string.IsNullOrWhiteSpace(newRole))
            AddValidationError("Role", "Role is required");

        if (string.IsNullOrWhiteSpace(newDepartment))
            AddValidationError("Department", "Department is required");

        if (string.IsNullOrWhiteSpace(newStatus))
            AddValidationError("Status", "Status is required");
    }

    private void ValidateEditForm()
    {
        editValidationErrors.Clear();

        if (string.IsNullOrWhiteSpace(editFirstName))
            AddEditValidationError("FirstName", "First name is required");
        else if (editFirstName.Length < 2)
            AddEditValidationError("FirstName", "First name must be at least 2 characters long");

        if (string.IsNullOrWhiteSpace(editLastName))
            AddEditValidationError("LastName", "Last name is required");
        else if (editLastName.Length < 2)
            AddEditValidationError("LastName", "Last name must be at least 2 characters long");

        if (string.IsNullOrWhiteSpace(editEmail))
            AddEditValidationError("Email", "Email is required");
        else if (!IsValidEmail(editEmail))
            AddEditValidationError("Email", "Please enter a valid email address");

        if (string.IsNullOrWhiteSpace(editRole))
            AddEditValidationError("Role", "Role is required");

        if (string.IsNullOrWhiteSpace(editDepartment))
            AddEditValidationError("Department", "Department is required");

        if (string.IsNullOrWhiteSpace(editStatus))
            AddEditValidationError("Status", "Status is required");
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private void AddValidationError(string field, string message)
    {
        validationErrors.Add($"{field}: {message}");
    }

    private void AddEditValidationError(string field, string message)
    {
        editValidationErrors.Add($"{field}: {message}");
    }

    private bool HasError(string field)
    {
        return validationErrors.Any(error => error.StartsWith($"{field}:"));
    }

    private bool HasEditError(string field)
    {
        return editValidationErrors.Any(error => error.StartsWith($"{field}:"));
    }

    private string GetError(string field)
    {
        return validationErrors.FirstOrDefault(error => error.StartsWith($"{field}:"))?.Split(':')[1]?.Trim() ?? "";
    }

    private string GetEditError(string field)
    {
        return editValidationErrors.FirstOrDefault(error => error.StartsWith($"{field}:"))?.Split(':')[1]?.Trim() ?? "";
    }

    private bool IsFormValid
    {
        get
        {
            ValidateAddForm();
            return validationErrors.Count == 0 &&
                   !string.IsNullOrWhiteSpace(newFirstName) &&
                   !string.IsNullOrWhiteSpace(newLastName) &&
                   !string.IsNullOrWhiteSpace(newEmail) &&
                   !string.IsNullOrWhiteSpace(newRole) &&
                   !string.IsNullOrWhiteSpace(newDepartment) &&
                   !string.IsNullOrWhiteSpace(newStatus);
        }
    }

    private bool IsEditFormValid
    {
        get
        {
            ValidateEditForm();
            return editValidationErrors.Count == 0 &&
                   !string.IsNullOrWhiteSpace(editFirstName) &&
                   !string.IsNullOrWhiteSpace(editLastName) &&
                   !string.IsNullOrWhiteSpace(editEmail) &&
                   !string.IsNullOrWhiteSpace(editRole) &&
                   !string.IsNullOrWhiteSpace(editDepartment) &&
                   !string.IsNullOrWhiteSpace(editStatus);
        }
    }

    // CRUD Operations
    private void AddUser()
    {
        ValidateAddForm();

        if (!IsFormValid)
        {
            errorMessage = "Please fix the validation errors before submitting.";
            return;
        }

        try
        {
            var newUser = new User
            {
                UserId = newUserId,
                FirstName = newFirstName.Trim(),
                LastName = newLastName.Trim(),
                Email = newEmail.Trim().ToLower(),
                Role = newRole,
                Department = newDepartment,
                Position = newPosition.Trim(),
                PhoneNumber = newPhoneNumber.Trim(),
                Status = newStatus,
                CreatedDate = DateTime.Now,
                LastLogin = null
            };

            users.Add(newUser);
            successMessage = $"User '{newUser.FullName}' added successfully!";

            CloseAddModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding user: {ex.Message}";
        }
    }

    private void UpdateUser()
    {
        ValidateEditForm();

        if (!IsEditFormValid || editingUser == null)
        {
            errorMessage = "Please fix the validation errors before submitting.";
            return;
        }

        try
        {
            var userToUpdate = users.FirstOrDefault(u => u.UserId == editingUser.UserId);
            if (userToUpdate != null)
            {
                userToUpdate.FirstName = editFirstName.Trim();
                userToUpdate.LastName = editLastName.Trim();
                userToUpdate.Email = editEmail.Trim().ToLower();
                userToUpdate.Role = editRole;
                userToUpdate.Department = editDepartment;
                userToUpdate.Position = editPosition.Trim();
                userToUpdate.PhoneNumber = editPhoneNumber.Trim();
                userToUpdate.Status = editStatus;

                successMessage = $"User '{userToUpdate.FullName}' updated successfully!";
            }

            CloseEditModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating user: {ex.Message}";
        }
    }

    private void ToggleUserStatus(User user)
    {
        try
        {
            var userToUpdate = users.FirstOrDefault(u => u.UserId == user.UserId);
            if (userToUpdate != null)
            {
                userToUpdate.Status = userToUpdate.Status == "Active" ? "Inactive" : "Active";
                successMessage = $"User '{userToUpdate.FullName}' has been {userToUpdate.Status.ToLower()}.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating user status: {ex.Message}";
        }
    }

    private void ResetPassword()
    {
        if (resettingUser == null) return;

        try
        {
            // In a real application, you would generate a temporary password and send it via email
            successMessage = $"Password reset instructions have been sent to {resettingUser.Email}.";
            CloseResetPasswordModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error resetting password: {ex.Message}";
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}