@page "/dashboard"
@layout MainLayout
@using MauiApp2.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="dashboard-wrapper">
    <aside class="sidebar">
        <div class="logo">
            <img src="images/quad.png" class="logo-img" />

            <h1 class="company-name">
                <span class="quad">Quad</span><span class="tech">Tech</span>
            </h1>
        </div>

        <nav class="nav-menu">
            <a href="/dashboard" class="nav-item active">
                <span class="icon">📊</span>
                <span>Dashboard</span>
            </a>

            <a href="/ordering" class="nav-item">
                <span class="icon">🛒</span>
                <span>Ordering</span>
            </a>

            <div class="nav-section">
                <div class="nav-section-header" @onclick="ToggleInventoryMenu">
                    <span class="icon">📋</span>
                    <span>Inventory Management</span>
                    <span class="chevron @(isInventoryMenuOpen ? "open" : "")">›</span>
                </div>
                @if (isInventoryMenuOpen)
                {
                    <div class="nav-section-links">
                        <a href="/products" class="nav-subitem">
                            <span class="subitem-icon">📦</span>
                            <span>Product List</span>
                        </a>
                        <a href="/stockin" class="nav-subitem">
                            <span class="subitem-icon">📥</span>
                            <span>Stock In</span>
                        </a>
                        <a href="/stockout" class="nav-subitem">
                            <span class="subitem-icon">📤</span>
                            <span>Stock Out</span>
                        </a>
                        <a href="/stockadjustment" class="nav-subitem">
                            <span class="subitem-icon">📦</span>
                            <span>Stock Adjustment</span>
                        </a>
                    </div>
                }
            </div>

        </nav>

        <div class="nav-footer">
            <button class="logout-btn" @onclick="Logout">
                <span class="icon">➜]</span>
                <span>Logout</span>
            </button>
        </div>
    </aside>

    <main class="main-content">
        <header class="header">
            <h1 class="page-title">Dashboard</h1>
            <div class="user-profile">
                <span class="user-icon">👤</span>
                <div class="user-info">
                    <span class="user-name">@AuthService.CurrentUser</span>
                    <span class="user-role">Admin</span>
                </div>
            </div>
        </header>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">Total User</span>
                    <div class="stat-icon user-icon-bg">
                        <span>👤</span>
                    </div>
                </div>
                <div class="stat-value">30,689</div>
                <div class="stat-trend positive">
                    <span class="trend-arrow">↗</span>
                    <span>6.5% Up from past week</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">Total Order</span>
                    <div class="stat-icon order-icon-bg">
                        <span>📄</span>
                    </div>
                </div>
                <div class="stat-value">10,293</div>
                <div class="stat-trend positive">
                    <span class="trend-arrow">↗</span>
                    <span>1.5% Up from past week</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">Total Sales</span>
                    <div class="stat-icon sales-icon-bg">
                        <span>📊</span>
                    </div>
                </div>
                <div class="stat-value">₱30,000</div>
                <div class="stat-trend negative">
                    <span class="trend-arrow down">↘</span>
                    <span>4.9% Down from yesterday</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-label">Total Pending</span>
                    <div class="stat-icon pending-icon-bg">
                        <span>⏱️</span>
                    </div>
                </div>
                <div class="stat-value">2,040</div>
                <div class="stat-trend positive">
                    <span class="trend-arrow">↗</span>
                    <span>1.3% Up from past week</span>
                </div>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <h2>Sales Details</h2>
                <select class="month-selector">
                    <option>October</option>
                    <option>September</option>
                    <option>August</option>
                </select>
            </div>
            <div class="chart">
                <svg viewBox="0 0 900 400" class="line-chart">
                    <line x1="60" y1="50" x2="60" y2="350" stroke="#e0e0e0" stroke-width="2" />
                    <line x1="60" y1="350" x2="860" y2="350" stroke="#e0e0e0" stroke-width="2" />

                    <line x1="60" y1="290" x2="860" y2="290" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="5,5" />
                    <line x1="60" y1="230" x2="860" y2="230" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="5,5" />
                    <line x1="60" y1="170" x2="860" y2="170" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="5,5" />
                    <line x1="60" y1="110" x2="860" y2="110" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="5,5" />
                    <line x1="60" y1="50" x2="860" y2="50" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="5,5" />

                    <text x="30" y="355" font-size="12" fill="#666">20%</text>
                    <text x="30" y="295" font-size="12" fill="#666">40%</text>
                    <text x="30" y="235" font-size="12" fill="#666">60%</text>
                    <text x="30" y="175" font-size="12" fill="#666">80%</text>
                    <text x="25" y="55" font-size="12" fill="#666">100%</text>

                    <text x="80" y="370" font-size="12" fill="#666">10k</text>
                    <text x="160" y="370" font-size="12" fill="#666">20k</text>
                    <text x="240" y="370" font-size="12" fill="#666">30k</text>
                    <text x="320" y="370" font-size="12" fill="#666">40k</text>
                    <text x="400" y="370" font-size="12" fill="#666">50k</text>
                    <text x="480" y="370" font-size="12" fill="#666">60k</text>
                    <text x="560" y="370" font-size="12" fill="#666">70k</text>
                    <text x="640" y="370" font-size="12" fill="#666">80k</text>
                    <text x="720" y="370" font-size="12" fill="#666">90k</text>
                    <text x="795" y="370" font-size="12" fill="#666">100k</text>
                    <text x="875" y="370" font-size="12" fill="#666">110k</text>

                    <polyline points="80,320 120,290 160,260 240,230 320,200 360,260 440,230 520,170 600,140 640,180 720,150 800,130 840,90 900,70"
                              fill="none"
                              stroke="#60a5fa"
                              stroke-width="3"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                    <circle cx="80" cy="320" r="4" fill="#60a5fa" />
                    <circle cx="120" cy="290" r="4" fill="#60a5fa" />
                    <circle cx="160" cy="260" r="4" fill="#60a5fa" />
                    <circle cx="240" cy="230" r="4" fill="#60a5fa" />
                    <circle cx="320" cy="200" r="4" fill="#60a5fa" />
                    <circle cx="360" cy="260" r="4" fill="#60a5fa" />
                    <circle cx="440" cy="230" r="4" fill="#60a5fa" />
                    <circle cx="520" cy="170" r="4" fill="#60a5fa" />
                    <circle cx="600" cy="140" r="4" fill="#60a5fa" />
                    <circle cx="640" cy="180" r="4" fill="#60a5fa" />
                    <circle cx="720" cy="150" r="4" fill="#60a5fa" />
                    <circle cx="800" cy="130" r="4" fill="#60a5fa" />
                    <circle cx="840" cy="90" r="4" fill="#60a5fa" />
                    <circle cx="900" cy="70" r="4" fill="#60a5fa" />
                </svg>
            </div>
        </div>
    </main>
</div>

@code {
    private bool isInventoryMenuOpen = false; 

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void ToggleInventoryMenu()
    {
        isInventoryMenuOpen = !isInventoryMenuOpen;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}